#!/bin/bash

# Anki Flashcard Generator

# Set IDE variable if not already set in environment
if [ -z "$IDE" ]; then
    IDE="open -a Windsurf"
fi
# Usage: fc [options] content
# Options:
#   -b          Basic card type (default)
#   -c          Cloze card type
#   -t "tags"   Specify tags (comma-separated)
#   -m "msg"    Custom instructions for Claude

show_help() {
    echo "Anki Flashcard Generator (fc)"
    echo ""
    echo "USAGE:"
    echo "  fc [options] content"
    echo "  echo 'content' | fc [options]"
    echo ""
    echo "OPTIONS:"
    echo "  -b          Generate Basic cards (default)"
    echo "  -c          Generate Cloze cards"
    echo "  -t TAGS     Add tags (comma-separated)"
    echo "  -m MESSAGE  Custom instructions for Claude"
    echo "  -h          Show this help"
    echo ""
    echo "EXAMPLES:"
    echo "  fc The mitochondria is the powerhouse of the cell"
    echo "  fc -c The {{c1::mitochondria}} is the {{c2::powerhouse}} of the cell"
    echo "  fc -t biology,cells The nucleus contains DNA"
    echo "  fc -c -m 'use multiple cloze deletions' Complex process"
    echo "  echo 'Complex topic' | fc -b -t advanced"
}

fc() {
    local card_type="basic"
    local tags=""
    local message=""
    local content=""
    local args=()
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -b|--basic)
                card_type="basic"
                shift
                ;;
            -c|--cloze)
                card_type="cloze"
                shift
                ;;
            -t|--tags)
                if [ -z "$2" ] || [[ "$2" == -* ]]; then
                    echo "Error: -t option requires an argument" >&2
                    show_help
                    return 1
                fi
                tags="$2"
                shift 2
                ;;
            -m|--message)
                if [ -z "$2" ] || [[ "$2" == -* ]]; then
                    echo "Error: -m option requires an argument" >&2
                    show_help
                    return 1
                fi
                message="$2"
                shift 2
                ;;
            -h|--help)
                show_help
                return 0
                ;;
            -*)
                echo "Unknown option: $1" >&2
                show_help
                return 1
                ;;
            *)
                args+=("$1")
                shift
                ;;
        esac
    done
    
    # Get content from arguments or stdin
    if [ ${#args[@]} -gt 0 ]; then
        content="${args[*]}"
    else
        if [ -t 0 ]; then
            echo "Error: No content provided" >&2
            show_help
            return 1
        fi
        content=$(cat)
    fi
    
    # Check if content is empty
    if [ -z "$content" ]; then
        echo "Error: No content provided" >&2
        show_help
        return 1
    fi
    
    # Build system prompt based on card type
    local system_prompt="You are an expert in Anki spaced repetition and memory optimization techniques. Your task is to create highly effective flashcards that maximize retention and minimize cognitive load.

CARD TYPE: $card_type

"

    if [ "$card_type" = "basic" ]; then
        system_prompt+="BASIC CARD GUIDELINES:
- Create clear question-answer pairs
- Use active recall principles (test knowledge, don't just repeat information)
- Apply the minimum information principle (one concept per card)
- Make questions specific and unambiguous
- Include context clues when helpful
- Break complex topics into multiple related cards
- Ensure answers are concise but complete

OUTPUT FORMAT (JSON):
{
  \"cards\": [
    {
      \"question\": \"Clear, specific question\",
      \"answer\": \"Concise, accurate answer\",
      \"extra\": \"Optional additional context or mnemonics\"
    }
  ]
}"
    else
        system_prompt+="CLOZE CARD GUIDELINES:
- DEFAULT: Use only ONE cloze deletion {{c1::text}} per card unless specifically instructed otherwise
- Use {{c1::text}}, {{c2::text}} format for cloze deletions only when multiple deletions are needed
- Number clozes logically (c1, c2, c3, etc.) if using multiple
- Each cloze should test a single concept
- Include enough context around clozes for clarity
- Make cloze deletions meaningful, not just random words
- Avoid making clozes too obvious or too obscure

OUTPUT FORMAT (JSON):
{
  \"cards\": [
    {
      \"question\": \"Text with {{c1::cloze}} {{c2::deletions}}\",
      \"extra\": \"Optional additional context or mnemonics\",
    }
  ]
}"
    fi
    
    system_prompt+="

Create the optimal number of flashcards (not limited to any specific count) to effectively memorize the provided content. Focus on quality and retention effectiveness.

IMPORTANT: Output ONLY the JSON structure. Do not include any explanatory text, markdown formatting, or code blocks. Return only the raw JSON object."
    
    # Add tags instruction if tags were provided
    if [ -n "$tags" ]; then
        system_prompt+="

TAGS: Add a 'tags' field to each card with the following tags as an array: [$tags]. Format tags as individual quoted strings in the array."
    else
        system_prompt+="

TAGS: Do not include a 'tags' field in the JSON output."
    fi
    
    # Prepare the prompt with content and tags
    local user_prompt="Content to convert into flashcards: $content"
    
    if [ -n "$tags" ]; then
        user_prompt+="

Tags to include: $tags"
    fi
    
    if [ -n "$message" ]; then
        user_prompt+="

Additional instructions: $message"
    fi
    
    # Execute Claude Code command and save to file
    local output_file="$HOME/flashcards.json"
    local response=$(claude -p "$user_prompt" --system-prompt "$system_prompt")
    
    # Extract the cards array from the response and write to file
    echo "$response" | jq '.cards' > "$output_file"
    
    echo "Flashcards saved to: $output_file"
    
    # Open the file in the preferred IDE
    $IDE "$output_file"
}

# Check if script is being executed directly
if [ "${BASH_SOURCE[0]}" == "${0}" ]; then
    fc "$@"
fi