#!/bin/bash

# Flashcard Content - Simple file creator and opener

# Source editor configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/editor" ]; then
    source "$SCRIPT_DIR/editor"
    IDE="$PREFERRED_EDITOR"
else
    # Fallback if editor config file doesn't exist
    if [ -z "$IDE" ]; then
        IDE="open -a Windsurf"
    fi
fi

# Create the fc-content.md file in home directory if it doesn't exist
content_file="$HOME/fc-content.md"

# Create file if it doesn't exist
if [ ! -f "$content_file" ]; then
    touch "$content_file"
fi

# Open the file in the preferred IDE
$IDE "$content_file"